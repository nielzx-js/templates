
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Verificação | NEXUS</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <main class="auth-shell">
    <section class="visual">
      <div class="brand">NEXUS</div>

      <div>
        <div class="eyebrow">Camada extra de segurança</div>
        <h2>Confirme que<br>é <span>você.</span></h2>
        <p>Confira seu e-mail e informe o código enviado para proteger sua conta.</p>
      </div>

      <div class="visual-foot">02 / 03 · Verificar identidade</div>
    </section>

    <section class="form-panel">
      <h1>Verifique seu e-mail</h1>
      <p class="sub">Digite o código de seis dígitos que enviamos para você.</p>

      <% if (typeof erro !== 'undefined' && erro) { %>
        <div class="alert alert-danger"><%= erro %></div>
      <% } %>

      <% if (typeof sucesso !== 'undefined' && sucesso) { %>
        <div class="alert alert-success"><%= sucesso %></div>
      <% } %>

      <form action="/verificacao" method="POST">
        <div class="mb-4">
          <label class="form-label" for="codigo">Código de verificação</label>
          <input class="form-control code-input" id="codigo" name="codigo"
            type="text" inputmode="numeric" pattern="[0-9]{6}"
            maxlength="6" autocomplete="one-time-code"
            placeholder="000000" required>
          <div class="small-note mt-2">Não compartilhe esse código com ninguém.</div>
        </div>

        <button class="btn btn-main w-100" type="submit">
          Confirmar código ↗
        </button>
      </form>

      <form action="/reenviar-codigo" method="POST" class="mt-3">
        <button class="btn btn-outline-secondary w-100" type="submit">
          Enviar código novamente
        </button>
      </form>

      <div class="auth-bottom">
        <a href="/login">Voltar para o login</a>
      </div>
    </section>
  </main>
</body>
</html>
