
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Verificação | STUDIO</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <main class="auth-shell">
    <section class="visual">
      <div class="brand">STUDIO / ACCOUNT</div>

      <div class="visual-main">
        <div class="visual-mark">✓</div>
        <h2>Proteção sem<br><span>complicação.</span></h2>
        <p>Confirme seu e-mail para manter sua conta protegida.</p>
      </div>

      <div class="visual-foot">Verificação de identidade.</div>
    </section>

    <section class="form-panel">
      <h1>Confira seu e-mail</h1>
      <p class="sub">Enviamos um código de seis dígitos para você.</p>

      <% if (typeof erro !== 'undefined' && erro) { %>
        <div class="alert alert-danger"><%= erro %></div>
      <% } %>

      <% if (typeof sucesso !== 'undefined' && sucesso) { %>
        <div class="alert alert-success"><%= sucesso %></div>
      <% } %>

      <form action="/verificacao" method="POST">
        <div class="mb-4">
          <label class="form-label" for="codigo">Código de verificação</label>
          <input class="form-control code-input" id="codigo" name="codigo"
            type="text" inputmode="numeric" pattern="[0-9]{6}"
            maxlength="6" autocomplete="one-time-code"
            placeholder="000000" required>
          <div class="small-note mt-2">O código é pessoal. Não compartilhe.</div>
        </div>

        <button class="btn btn-main w-100" type="submit">
          Verificar e continuar
        </button>
      </form>

      <form action="/reenviar-codigo" method="POST" class="mt-3">
        <button class="btn btn-outline-secondary w-100" type="submit">
          Reenviar código
        </button>
      </form>

      <div class="auth-bottom">
        <a href="/login">Voltar para o login</a>
      </div>
    </section>
  </main>
</body>
</html>
